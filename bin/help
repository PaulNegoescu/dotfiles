#!/bin/bash
#
# Display dotfiles documentation or fall back to the tldr-pages project.
# > More information: <https://github.com/tldr-pages/tlrc>.
#
# - Print `docs/README.md`:
#
# `help`
#
# - Print the tldr page for a specific command (hint: this is how you got here!):
#
# `help {{command}}`
#
# ---
# Author: Nick Plekhanov, https://plekhanov.me
# License: MIT
# https://github.com/nicksp/dotfiles

cd "$(dirname "$0")/.." || exit

DOTFILES_DIR="$(pwd)"
config="$DOTFILES_DIR/tilde/.tlrc.toml"

render_markdown() {
  if command -v glow > /dev/null; then
    glow "$1"
  elif command -v bat > /dev/null; then
    bat --language=markdown --paging=never --style=plain "$1"
  else
    command cat "$1"
  fi
}

if (($# == 0)); then
  render_markdown "$DOTFILES_DIR/docs/README.md"
  exit
fi

md="$("$DOTFILES_DIR"/bin/lib/get-tldr-md "$1")"

if [[ "$md" == "$DOTFILES_DIR/docs/"* ]]; then
  render_markdown "$md"
elif [[ -n "$md" ]]; then
  tldr --config "$config" --render "$md"
else
  tldr --config "$config" "$@"
fi

#!/bin/bash
#
# Reinstall Node.js dependencies without deleting the project's lockfile.
#
# - Clean up local Node packages installation:
#
# `npmplease`
#
# ---
# Author: Nick Plekhanov, https://plekhanov.me
# License: MIT
# https://github.com/nicksp/dotfiles

set -euo pipefail

if [ ! -f package.json ]; then
  echo "No package.json found in the current directory." >&2
  exit 1
fi

rm -rf ./node_modules

if [ -f pnpm-lock.yaml ]; then
  command -v pnpm > /dev/null || {
    echo "pnpm is required for this project." >&2
    exit 1
  }
  pnpm install --frozen-lockfile
elif [ -f package-lock.json ]; then
  npm ci
elif [ -f yarn.lock ]; then
  command -v corepack > /dev/null || {
    echo "Corepack is required for this Yarn project." >&2
    exit 1
  }
  corepack yarn install
else
  npm install
fi

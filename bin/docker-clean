#!/bin/bash
#
# Clear Podman cache and free up space on the system without asking for confirmation.
# >  - all stopped containers
# >  - all unused networks
# >  - all unused anonymous volumes
# >  - all unused (incl. dandling) images
# >  - all build cache
#
# > Show Podman disk usage at the end.
#
# - Remove dangling Podman items:
#
# `docker-clean`
#
# ---
# Based on https://docs.podman.io/en/stable/markdown/podman-system-prune.1.html
#
# Author: Nick Plekhanov, https://plekhanov.me
# License: MIT
# https://github.com/nicksp/dotfiles

podman system prune -af --volumes \
  && podman system df

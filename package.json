{
  "name": "dotfiles",
  "version": "0.0.1",
  "type": "module",
  "description": "My personal dotfiles for configuring macOS with Zsh and Homebrew.",
  "packageManager": "pnpm@12.5.1+sha512.e3f305bc784a2bc89f5ad3b6138889470fae8d2af5f36b61216ec91c2c3d64089775f9de38aac331044ea40f245cb0d5666392dfdf65824e1907ef6a2c62de5f",
  "private": true,
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "check": "bin/lib/check",
    "format": "prettier --log-level warn --ignore-unknown --write \"**/*.{js,cjs,ts,md,json,sh}\" \"bin/*\""
  },
  "author": "Paul Negoescu",
  "license": "MIT",
  "dependencies": {
    "avif": "^0.5.3"
  },
  "devDependencies": {
    "prettier": "^3.8.3",
    "prettier-plugin-sh": "^0.18.1"
  }
}
